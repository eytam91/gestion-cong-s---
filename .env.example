# This app talks to Cloud Firestore directly from the browser using the Firebase
# Web SDK. Its configuration lives in firebase-applet-config.json, which is
# injected by AI Studio — there is nothing to copy here for a normal run.
#
# Note on the Firebase web API key in that file: it is an identifier, not a
# secret. Google documents it as safe to ship in client code. What actually
# protects the data is firestore.rules plus Firebase Authentication, so review
# firestore.rules before deploying rather than trying to hide the key.

# Port the Express host listens on (defaults to 3000).
PORT=3000

# Set to "production" to serve the built SPA from dist/ instead of Vite dev.
NODE_ENV=development

# Set to "true" to disable HMR and file watching (used by AI Studio).
DISABLE_HMR=false
