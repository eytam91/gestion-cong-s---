rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }
    
    // Validation Helper: Users
    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 256;
    }
    
    // Validation Helper: Employees
    function isValidEmployee(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.hireDate is string && data.hireDate.size() >= 4 && data.hireDate.size() <= 32 &&
             data.contractType is string && data.contractType.size() > 0 && data.contractType.size() <= 64;
    }
    
    // Validation Helper: Leave Records
    function isValidLeaveRecord(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.employeeId is string && data.employeeId.size() > 0 && data.employeeId.size() <= 128 &&
             data.startDate is string && data.startDate.size() >= 4 && data.startDate.size() <= 32 &&
             data.endDate is string && data.endDate.size() >= 4 && data.endDate.size() <= 32 &&
             data.daysCount is number && data.daysCount >= 0 &&
             data.leaveType is string && data.leaveType.size() > 0 && data.leaveType.size() <= 64;
    }
    
    // Validation Helper: Audit Logs
    function isValidAuditLog(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() >= 4 && data.timestamp.size() <= 64 &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 128 &&
             data.actionLabel is string && data.actionLabel.size() > 0 && data.actionLabel.size() <= 256;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email']))
      );
      allow delete: if isAdmin();
    }
    
    // Employees Collection
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(employeeId) && isValidEmployee(incoming());
      allow update: if isSignedIn() && isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isSignedIn();
    }
    
    // Leave Records Collection
    match /leave_records/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(leaveId) && isValidLeaveRecord(incoming());
      allow update: if isSignedIn() && isValidId(leaveId) && isValidLeaveRecord(incoming());
      allow delete: if isSignedIn();
    }
    
    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
