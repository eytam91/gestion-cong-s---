rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users Collection (Admin / HR accounts)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if true;
    }
    
    // Employees Collection
    match /employees/{employeeId} {
      allow read: if true;
      allow create, update: if isValidId(employeeId);
      allow delete: if true;
    }
    
    // Leave Records Collection
    match /leave_records/{leaveId} {
      allow read: if true;
      allow create, update: if isValidId(leaveId);
      allow delete: if true;
    }
    
    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId);
      allow delete: if true;
    }
  }
}
