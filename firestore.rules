rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId);
      allow delete: if isSignedIn();
    }
    
    // Employees Collection
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(employeeId);
      allow update: if isSignedIn() && isValidId(employeeId);
      allow delete: if isSignedIn();
    }
    
    // Leave Records Collection
    match /leave_records/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(leaveId);
      allow update: if isSignedIn() && isValidId(leaveId);
      allow delete: if isSignedIn();
    }
    
    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if isSignedIn();
    }
  }
}
